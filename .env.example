PORT=5000
JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_NAME=Store Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Optional: restrict browser access to your deployed site (comma-separated origins).
# CORS_ORIGIN=https://yourdomain.com

# Optional: turn on generative AI replies for the shopping assistant.
# Without a key, the built-in catalogue assistant still replies automatically.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=20000
